   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $env.TG_URL }}/sendMessage",
    "options": {},
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ chat_id: $env.TG_CHAT, text: '🔥 Новая заявка №' + $json.id + ': ' + $json.name + ', ' + $json.phone + ($json.comment ? '\\n' + $json.comment : '') }) }}"
   }
  },
  {
   "id": "2c7fb182-2871-5d4b-b26d-108f6960ecb4",
   "name": "Ответ: принято",
