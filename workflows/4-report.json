   "parameters": {
    "jsCode": "const items = $input.first().json.items || [];\nconst paid = items.filter((l) => l.status === 'paid');\nconst sum = paid.reduce((s, l) => s + (l.paid || 0), 0);\nconst text = `📊 Сделки: ${items.length}\\nНовые: ${items.length - paid.length}\\nОплачено: ${paid.length} на ${sum.toLocaleString('ru-RU')} ₽`;\nreturn [{ json: { text, total: items.length, paid: paid.length, sum } }];"
   }
  },
  {
   "id": "ff6e766f-9dbb-507a-8e79-ded5888ca845",
   "name": "Telegram: отчёт",
